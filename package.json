{
  "name": "ipl-data-platform",
  "version": "1.0.0",
  "description": "Full-stack IPL Data Platform - Cricket Insights & Analytics",
  "scripts": {
    "setup": "node setup.js",
    "backend:install": "cd backend && npm install",
    "backend:dev": "cd backend && npm run dev",
    "backend:seed": "cd backend && npm run seed",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm start",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "ipl",
    "cricket",
    "fullstack",
    "react",
    "nodejs",
    "postgresql",
    "api",
    "dashboard"
  ],
  "author": "Your Name",
  "license": "MIT",
  "directories": {
    "backend": "./backend",
    "frontend": "./frontend",
    "dataset": "./dataset"
  },
  "requirements": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0",
    "postgresql": ">=12.0"
  },
  "deployment": {
    "backend": "Render/Railway/Heroku",
    "frontend": "Vercel/Netlify/Render",
    "database": "Render PostgreSQL/Railway PostgreSQL"
  },
  "features": {
    "matches": "74 IPL match scorecards",
    "teams": "10 IPL teams",
    "players": "500+ player profiles",
    "api": "RESTful with Swagger docs",
    "frontend": "React with charts and analytics",
    "database": "PostgreSQL with Prisma ORM"
  }
}
